{
  "name": "desktop-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start:host": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --host\"",
    "start:viewer": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:exe": "npm run build && npx electron-packager . \"Omniscreen\" --platform=win32 --arch=x64 --out=dist-app --overwrite --ignore=\"^/(src|node_modules|\\.git|dist-app)\""
  },
  "build": {
    "appId": "com.omniscreen.remotedesktop",
    "productName": "Omniscreen",
    "asar": false,
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "target": "dir",
      "sign": false,
      "signDlls": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "overrides": {
    "@noble/hashes": "1.3.3"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "joi": "^18.2.3",
    "mime-db": "^1.54.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "wait-on": "^8.0.5"
  }
}
